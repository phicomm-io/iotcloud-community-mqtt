server {
    listen 80;
    listen [::]:80;
    server_name mqtt.fjrcn.com;
    location /.well-known/acme-challenge/ { root /var/www/mqtt-acme; }
    location / { return 301 https://mqtt.fjrcn.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mqtt.fjrcn.com;
    ssl_certificate /etc/letsencrypt/live/mqtt.fjrcn.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mqtt.fjrcn.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:19001;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
